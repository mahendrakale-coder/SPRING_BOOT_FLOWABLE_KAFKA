<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="Examples">

    <!-- ✅ ADD THIS -->
    <message id="loanApprovedMessage" name="loanApprovedMessage"/>

    <process id="docApproval" name="Document Approval Process" isExecutable="true">

        <startEvent id="startEvent"/>

        <sequenceFlow sourceRef="startEvent" targetRef="userTask1"/>

        <userTask id="userTask1"
                  name="Approve Document"
                  flowable:assignee="john"/>

        <sequenceFlow sourceRef="userTask1" targetRef="sendKafkaEvent"/>

        <serviceTask id="sendKafkaEvent"
                     name="Send Kafka Event"
                     flowable:delegateExpression="${kafkaSendDelegate}"/>

        <sequenceFlow sourceRef="sendKafkaEvent" targetRef="waitKafka"/>

        <intermediateCatchEvent id="waitKafka">
            <messageEventDefinition messageRef="loanApprovedMessage"/>
        </intermediateCatchEvent>

        <sequenceFlow sourceRef="waitKafka" targetRef="endEvent"/>

        <endEvent id="endEvent"/>

    </process>
</definitions>