<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="Examples">

    <process id="docApproval" name="Document Approval Process" isExecutable="true">

        <startEvent id="startEvent" />

        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="userTask1"/>

        <userTask id="userTask1"
                  name="Approve Document"
                  flowable:assignee="john" />

        <sequenceFlow id="flow2" sourceRef="userTask1" targetRef="sendKafkaEvent"/>

        <!-- ✅ REPLACED SERVICE TASK -->
        <serviceTask id="sendKafkaEvent"
                     name="Send Kafka Event"
                     flowable:type="send-event"
                     flowable:eventType="loanEvent"
                     flowable:channelKey="kafkaLoanChannel" />

        <sequenceFlow id="flow3" sourceRef="sendKafkaEvent" targetRef="endEvent"/>

        <endEvent id="endEvent" />

    </process>
</definitions>